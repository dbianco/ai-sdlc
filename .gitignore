# OS files
.DS_Store

# Editor / IDE config (keep local, don't publish)
.vscode/

# Internal deployment manifests (not part of the public plugin)
_deployment-manifests/

# Metrics data (safety net — actual data lives at ~/.claude/metrics/)
*.jsonl

# Claude Code plans (local only)
.claude/plans/

# Worktree artifacts (top-level workspace directories only)
/workspace-*/

# Claude Code worktrees (nested checkouts — never commit these)
.claude/worktrees/

# Subagent-driven-development scratch (ledgers, briefs, review packages)
.superpowers/

/presentations/!_deployment-manifests/**
